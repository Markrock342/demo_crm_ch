    "bcryptjs": "^3.0.2",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.13.5",
    "jose": "^6.1.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
