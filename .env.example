GEMINI_API_KEY=
# gemini-3.8-flash (latest GA) | gemini-3.7-flash | gemini-3.5-flash
GEMINI_MODEL=gemini-3.8-flash
PORT=8787

# Production foundation
# Local direct: postgresql://cangzhan:cangzhan@localhost:5432/cangzhan
# Local via PgBouncer: postgresql://cangzhan:cangzhan@localhost:6432/cangzhan
# Vercel/Neon/Supabase: use the provider's *pooled* connection string
DATABASE_URL=postgresql://cangzhan:cangzhan@localhost:5432/cangzhan

# Postgres connections per API process.
#   Vercel / serverless: 1 (many short-lived instances; use the provider's pooled URL).
#   VPS / long-running `node server` (~100 daily users): 10–20 per process, keeping
#   (processes × DB_POOL_MAX) under Postgres max_connections (default 100) minus admin headroom.
#   Local dev: 3 is plenty.
DB_POOL_MAX=3
# Seconds an idle pooled connection is kept (VPS: 60–300; serverless: 20).
DB_IDLE_TIMEOUT=
# Session roles/tenant cache per process, ms (0 = off). Revocation (password change / deactivate) is always instant.
AUTH_CACHE_TTL_MS=
# VPS only: serve the built SPA (dist/) from the API process with .br/.gz and immutable /assets caching.
SERVE_STATIC=
STATIC_DIR=
# Bind address for `node server` (default 127.0.0.1; 0.0.0.0 behind a reverse proxy in a container).
HOST=
# Load test login (scripts/scale-data.ts creates it in a separate synthetic org; local only).
LOADTEST_PASSWORD=

JWT_SECRET=change-me-use-long-random-string

# Outbound email. sandbox (default) = never delivers, keeps an in-memory outbox for dev.
# smtp = deliver via SMTP (nodemailer). Sent/failed mail is stored in the mails table.
EMAIL_TRANSPORT=sandbox
# Required when EMAIL_TRANSPORT=smtp. MAIL_FROM e.g. "CANGZHAN Freight <billing@example.com>"
MAIL_FROM=
SMTP_HOST=
# 587 (STARTTLS, default) or 465 (implicit TLS)
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# true for port 465; leave empty to infer from the port
SMTP_SECURE=
# Public web address used in emailed links (quotation accept link, portal sign-in), e.g. https://crm.example.com
# Falls back to the request's origin when empty.
APP_BASE_URL=
# Optional shared secret for POST /api/webhooks/inbound-mail
# WEBHOOK_SECRET=

# Automation / notifications
# Vercel Cron calls GET /api/cron/automation with "Authorization: Bearer $CRON_SECRET" (set it in Vercel env).
CRON_SECRET=
# Local/long-running servers run rules every 10 min; set to "off" to disable the in-process scheduler.
# AUTOMATION_SCHEDULER=off
# LINE Messaging API (company LINE Official Account). Leave empty to hide LINE.
# Webhook URL to set in LINE Developers console: https://<your-domain>/api/webhooks/line
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# OA basic id, e.g. @abc1234 (shown to users as "add friend")
LINE_OA_ID=
