GEMINI_API_KEY=
# gemini-3.8-flash (latest GA) | gemini-3.7-flash | gemini-3.5-flash
GEMINI_MODEL=gemini-3.8-flash
PORT=8787

# Production foundation
# Local direct: postgresql://cangzhan:cangzhan@localhost:5432/cangzhan
# Local via PgBouncer: postgresql://cangzhan:cangzhan@localhost:6432/cangzhan
# Vercel/Neon/Supabase: use the provider's *pooled* connection string
DATABASE_URL=postgresql://cangzhan:cangzhan@localhost:5432/cangzhan

# Serverless: set to 1 on Vercel. Local direct: 3. Via PgBouncer: 1–3.
DB_POOL_MAX=3

JWT_SECRET=change-me-use-long-random-string

# Phase C — email (sandbox default; SMTP/Gmail Deferred)
EMAIL_TRANSPORT=sandbox
# Optional shared secret for POST /api/webhooks/inbound-mail
# WEBHOOK_SECRET=
