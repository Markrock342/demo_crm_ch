{
  "regions": [
    "sin1"
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/ai/*.ts": {
      "includeFiles": "server/**",
      "maxDuration": 60
    },
    "api/auth/*.ts": {
      "includeFiles": "server/**",
      "maxDuration": 30
    },
    "api/[...path].ts": {
      "includeFiles": "server/**",
      "maxDuration": 30
    },
    "api/health.ts": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
